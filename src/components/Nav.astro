---
import ThemeToggle from './ThemeToggle.astro';

const links = [
  { label: 'Home', href: '/' },
  { label: 'Stack', href: '/stack/' },
  { label: 'Experience', href: '/experience/' },
  { label: 'Education', href: '/education/' },
  { label: 'Projects', href: '/projects/' },
  { label: 'Connect', href: '/connect/' },
];

/** Trailing slashes are normalised so `/stack` and `/stack/` both match. */
const path = '/' + (Astro.url.pathname.replace(/^\/|\/$/g, '') || '');

const isActive = (href: string) => {
  const target = '/' + href.replace(/^\/|\/$/g, '');
  return href === '/' ? path === '/' : path === target || path.startsWith(target + '/');
};
---

<header class="nav">
  <nav class="shell" aria-label="Primary">
    <!-- The accessible name has to contain the visible text, or voice control
         cannot target it ("click RW"). Hidden text rather than an aria-label. -->
    <a href="/" class="mark">RW<span>.</span><span class="sr-only"> — Ryan Walker, home</span></a>

    <div class="right">
      <ul class="links">
        {
          links.map((l) => (
            <li>
              <a href={l.href} aria-current={isActive(l.href) ? 'page' : undefined}>
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
      <ThemeToggle />
    </div>
  </nav>
</header>

<style>
  .nav {
    border-bottom: 1px solid var(--hairline);
    background: var(--canvas);
  }

  .shell {
    max-width: var(--container-shell);
    margin: 0 auto;
    padding: 0 40px;
    min-height: 68px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .mark {
    font-family: var(--font-display), sans-serif;
    font-weight: 800;
    font-size: 15px;
    letter-spacing: -0.01em;
    color: var(--text);
  }

  .mark span { color: var(--accent); }

  .right {
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .links {
    display: flex;
    gap: 30px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-mono), ui-monospace, monospace;
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .links a { color: var(--muted); }
  .links a:hover { color: var(--accent); }

  .links a[aria-current='page'] { color: var(--text); }

  @media (max-width: 860px) {
    .shell {
      padding: 12px 24px;
      flex-wrap: wrap;
    }

    .right {
      width: 100%;
      justify-content: space-between;
    }

    .links {
      gap: 20px;
      flex-wrap: wrap;
      font-size: 11px;
    }
  }
</style>
