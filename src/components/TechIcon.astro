---
/**
 * TechIcon — renders one technology mark from the icon registry.
 *
 * The registry (src/data/icons.json) is generated by `npm run icons`. Three shapes:
 *
 *   si  — Simple Icons: one 24x24 path, with a `dark` and `light` brand colour
 *   dv  — Devicon: full inline multi-colour SVG, one variant per theme
 *   txt — no logo exists: a mono monogram tile (Assembly, SQL, EKS, ...)
 *
 * Every colour is precomputed per theme so each mark clears 3:1 against the
 * surface it sits on. A single set of colours cannot serve both themes — marks
 * lifted toward white for the dark canvas go invisible on a light one. Do not
 * re-derive them here; change the thresholds in scripts/build-icons.mjs and
 * re-run `npm run icons`, then `npm run contrast` to verify.
 */
import groups from '../data/icons.json';

type SimpleIcon = {
  label: string;
  src: 'si';
  path: string;
  dark: string;
  light: string;
  raw: string;
  /** Custom marks may sit on a different grid — see CUSTOM in build-icons.mjs. */
  viewBox?: string;
};
type DevIcon =
  | { label: string; src: 'dv'; plate: false; svgDark: string; svgLight: string }
  /** Polychrome mark: real colours on a neutral plate, one variant for both themes. */
  | { label: string; src: 'dv'; plate: true; svg: string };
type TextIcon = { label: string; src: 'txt'; note: string };
type Icon = SimpleIcon | DevIcon | TextIcon;

const registry = new Map<string, Icon>(
  (groups as { name: string; items: Icon[] }[]).flatMap((g) =>
    g.items.map((i) => [i.label.toLowerCase(), i] as const),
  ),
);

interface Props {
  /** Must match a `label` in the registry, case-insensitively. */
  label: string;
  /** Rendered box in px. The design uses 25 on the Stack grid. */
  size?: number;
  /** Force the mark to inherit `currentColor` — for inline chips and hover states. */
  monochrome?: boolean;
  class?: string;
}

const { label, size = 25, monochrome = false, class: className } = Astro.props;

/**
 * Inline SVG ids are document-global, and a Devicon mark carries its own
 * gradient defs. The dual-theme marks emit the same markup twice, so without
 * this the two variants collide on `matlab-original-a` and friends — invalid
 * HTML, and a rendering hazard the moment two instances differ. Namespacing per
 * instance also makes it safe to render the same icon more than once on a page.
 */
let instances = 0;

const namespaceIds = (svg: string, suffix: string) =>
  svg
    .replace(/\bid="([^"]+)"/g, (_m, id) => `id="${id}-${suffix}"`)
    .replace(/url\(#([^)]+)\)/g, (_m, id) => `url(#${id}-${suffix})`)
    .replace(/\b(xlink:href|href)="#([^"]+)"/g, (_m, attr, id) => `${attr}="#${id}-${suffix}"`);


const icon = registry.get(label.toLowerCase());

if (!icon) {
  // Fail the build rather than silently dropping a mark: a typo in a `stack:`
  // array should never ship as an invisible gap in the grid.
  throw new Error(
    `TechIcon: no icon registered for "${label}". ` +
      `Add it to scripts/build-icons.mjs and re-run \`npm run icons\`.`,
  );
}

/** "ECS Fargate" -> "EF". Matches the approved monogram derivation. */
const initials = (s: string) =>
  s
    .replace(/[^A-Za-z0-9 ]/g, '')
    .split(/\s+/)
    .map((w) => w[0])
    .join('')
    .slice(0, 3)
    .toUpperCase();

const box = `${size}px`;

const uid = `i${(instances += 1)}`;
const plateSvg = icon.src === 'dv' && icon.plate ? namespaceIds(icon.svg, uid) : '';
const darkSvg = icon.src === 'dv' && !icon.plate ? namespaceIds(icon.svgDark, `${uid}d`) : '';
const lightSvg = icon.src === 'dv' && !icon.plate ? namespaceIds(icon.svgLight, `${uid}l`) : '';
---

{
  icon.src === 'si' && (
    <svg
      class:list={['tech-icon', monochrome && 'tech-icon--mono-fill', className]}
      style={monochrome ? undefined : `--fill-dark:${icon.dark};--fill-light:${icon.light}`}
      viewBox={icon.viewBox ?? '0 0 24 24'}
      width={size}
      height={size}
      role="img"
      aria-label={icon.label}
    >
      <path d={icon.path} />
    </svg>
  )
}

{
  icon.src === 'dv' && icon.plate && (
    <span
      class:list={['tech-icon', 'tech-icon--plate', className]}
      style={`width:${box};height:${box}`}
      role="img"
      aria-label={icon.label}
      set:html={plateSvg}
    />
  )
}

{
  icon.src === 'dv' && !icon.plate && (
    <span
      class:list={['tech-icon', 'tech-icon--dv', className]}
      style={`width:${box};height:${box}`}
      role="img"
      aria-label={icon.label}
    >
      <span class="dv dv--dark" aria-hidden="true" set:html={darkSvg} />
      <span class="dv dv--light" aria-hidden="true" set:html={lightSvg} />
    </span>
  )
}

{
  icon.src === 'txt' && (
    <span
      class:list={['tech-icon', 'tech-icon--tile', className]}
      style={`width:${box};height:${box}`}
      role="img"
      aria-label={icon.label}
    >
      {initials(icon.label)}
    </span>
  )
}

<style>
  .tech-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
  }

  /* Single-path marks: the per-theme fills ride on the element itself, so one
     rule per theme resolves whichever variable applies. */
  svg.tech-icon {
    fill: var(--fill-dark);
  }

  :global([data-theme='light']) svg.tech-icon {
    fill: var(--fill-light);
  }

  svg.tech-icon--mono-fill,
  :global([data-theme='light']) svg.tech-icon--mono-fill {
    fill: currentColor;
  }

  /* Multi-colour marks cannot be recoloured with one variable, so both themed
     variants are emitted and the inactive one is hidden. Four icons only. */
  .tech-icon--dv {
    position: relative;
  }

  .dv {
    position: absolute;
    inset: 0;
  }

  .dv :global(svg) {
    width: 100%;
    height: 100%;
    display: block;
  }

  .dv--light { display: none; }

  :global([data-theme='light']) .dv--dark { display: none; }
  :global([data-theme='light']) .dv--light { display: block; }

  /* Polychrome marks keep their real colours and get the light ground they
     were designed for. Inset so the plate reads as a chip, not a border. */
  .tech-icon--plate {
    background: var(--icon-plate);
    border-radius: 3px;
    padding: 2px;
  }

  .tech-icon--plate :global(svg) {
    width: 100%;
    height: 100%;
    display: block;
  }

  .tech-icon--tile {
    border: 1px solid var(--monogram-border);
    border-radius: 3px;
    font-family: var(--font-mono), ui-monospace, monospace;
    font-size: 9px;
    letter-spacing: 0.04em;
    color: var(--muted);
  }
</style>
