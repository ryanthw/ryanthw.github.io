---
/**
 * TechIcon — renders one technology mark from the approved icon registry.
 *
 * The registry (src/data/icons.json) is generated by `npm run icons` and is
 * byte-identical to the set approved on the design canvas. Three shapes:
 *
 *   si  — Simple Icons: one 24x24 path + a legibility-corrected brand colour
 *   dv  — Devicon: full inline multi-colour SVG (Java, MATLAB, Matplotlib, AWS)
 *   txt — no logo exists: a mono monogram tile (Assembly, SQL, EKS, ...)
 *
 * Colours in the registry are pre-lifted toward white so dark brand marks read
 * on #0A0A0B. Do not re-derive them here — see PLAN.md "Colour legibility rule".
 */
import groups from '../data/icons.json';

type SimpleIcon = { label: string; src: 'si'; path: string; color: string; raw: string };
type DevIcon = { label: string; src: 'dv'; svg: string; color: null };
type TextIcon = { label: string; src: 'txt'; note: string };
type Icon = SimpleIcon | DevIcon | TextIcon;

const registry = new Map<string, Icon>(
  (groups as { name: string; items: Icon[] }[]).flatMap((g) =>
    g.items.map((i) => [i.label.toLowerCase(), i] as const),
  ),
);

interface Props {
  /** Must match a `label` in the registry, case-insensitively. */
  label: string;
  /** Rendered box in px. The design uses 25 on the Stack grid. */
  size?: number;
  /** Force the mark to inherit `currentColor` — for inline chips and hover states. */
  monochrome?: boolean;
  class?: string;
}

const { label, size = 25, monochrome = false, class: className } = Astro.props;

const icon = registry.get(label.toLowerCase());

if (!icon) {
  // Fail the build rather than silently dropping a mark: a typo in a `stack:`
  // array should never ship as an invisible gap in the grid.
  throw new Error(
    `TechIcon: no icon registered for "${label}". ` +
      `Add it to scripts/build-icons.mjs and re-run \`npm run icons\`.`,
  );
}

/** "ECS Fargate" -> "EF". Matches the approved monogram derivation. */
const initials = (s: string) =>
  s
    .replace(/[^A-Za-z0-9 ]/g, '')
    .split(/\s+/)
    .map((w) => w[0])
    .join('')
    .slice(0, 3)
    .toUpperCase();

const box = `${size}px`;
---

{
  icon.src === 'si' && (
    <svg
      class:list={['tech-icon', className]}
      viewBox="0 0 24 24"
      width={size}
      height={size}
      fill={monochrome ? 'currentColor' : icon.color}
      role="img"
      aria-label={icon.label}
    >
      <path d={icon.path} />
    </svg>
  )
}

{
  icon.src === 'dv' && (
    <span
      class:list={['tech-icon', 'tech-icon--inline', className]}
      style={`width:${box};height:${box}`}
      role="img"
      aria-label={icon.label}
      set:html={icon.svg}
    />
  )
}

{
  icon.src === 'txt' && (
    <span
      class:list={['tech-icon', 'tech-icon--mono', className]}
      style={`width:${box};height:${box}`}
      role="img"
      aria-label={icon.label}
    >
      {initials(icon.label)}
    </span>
  )
}

<style>
  .tech-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
  }

  /* Devicon markup is injected, so it sits outside Astro's scoping. */
  .tech-icon--inline :global(svg) {
    width: 100%;
    height: 100%;
    display: block;
  }

  .tech-icon--mono {
    border: 1px solid var(--monogram-border);
    border-radius: 3px;
    font-family: var(--font-mono), ui-monospace, monospace;
    font-size: 9px;
    letter-spacing: 0.04em;
    color: var(--muted);
  }
</style>
