---
/**
 * The eyebrow + display-title + lede block that opens Stack, Education and
 * Connect. Home has its own hero, so it does not use this.
 *
 * `size` maps to the two heading scales in the approved artboards: 54px for
 * the section pages, 64px for Connect's "Let's talk".
 */
interface Props {
  eyebrow: string;
  title: string;
  lede?: string;
  size?: 'section' | 'display';
  class?: string;
}

const { eyebrow, title, lede, size = 'section', class: className } = Astro.props;
---

<header class:list={['head', `head--${size}`, className]} data-animate>
  <p class="eyebrow">{eyebrow}</p>
  <h1>{title}</h1>
  {lede && <p class="lede">{lede}</p>}
  <slot />
</header>

<style>
  .head {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding-top: 64px;
    padding-bottom: 34px;
  }

  .head p { margin: 0; }

  h1 {
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.03em;
    text-transform: uppercase;
  }

  .head--section h1 { font-size: clamp(36px, 6vw, 54px); }

  .head--display h1 {
    font-size: clamp(42px, 7.4vw, 64px);
    line-height: 0.98;
    letter-spacing: -0.034em;
  }

  .lede {
    max-width: 58ch;
    font-size: 16px;
    color: var(--muted);
  }

  .head--display .lede {
    font-size: 17px;
    max-width: 52ch;
    color: var(--prose);
    line-height: 1.6;
  }

  @media (max-width: 860px) {
    .head { padding-top: 44px; }
  }
</style>
