---
/**
 * Theme toggle. The no-flash script lives in BaseLayout's <head> and runs
 * before first paint; this component only handles the click and the icon
 * swap, so it can hydrate late without causing a flicker.
 */
---

<button
  id="theme-toggle"
  type="button"
  class="toggle"
  aria-label="Switch colour theme"
  title="Switch colour theme"
>
  <svg class="icon icon--sun" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
  </svg>
  <svg class="icon icon--moon" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
  </svg>
</button>

<style>
  .toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    padding: 0;
    background: none;
    border: 1px solid var(--hairline);
    border-radius: 2px;
    color: var(--muted);
    cursor: pointer;
    transition: color 120ms var(--ease-out-soft), border-color 120ms var(--ease-out-soft);
  }

  .toggle:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  /* Show the icon for the theme you'd switch *to*. */
  .icon--sun { display: none; }
  .icon--moon { display: block; }

  :global([data-theme='light']) .icon--sun { display: block; }
  :global([data-theme='light']) .icon--moon { display: none; }
</style>

<script>
  const KEY = 'rw-theme';

  function wire() {
    const btn = document.getElementById('theme-toggle');
    if (!btn || btn.dataset.wired) return;
    btn.dataset.wired = 'true';

    btn.addEventListener('click', () => {
      const root = document.documentElement;
      const next = root.dataset.theme === 'light' ? 'dark' : 'light';
      root.dataset.theme = next;
      try {
        localStorage.setItem(KEY, next);
      } catch {
        /* private mode — the choice just won't persist */
      }
    });
  }

  wire();
  document.addEventListener('astro:after-swap', wire);
</script>
