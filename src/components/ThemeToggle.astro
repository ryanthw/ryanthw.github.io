---
/**
 * Theme toggle. The no-flash script lives in BaseLayout's <head> and runs
 * before first paint; this component only handles the click and the icon
 * swap, so it can hydrate late without causing a flicker.
 */
---

<button
  id="theme-toggle"
  type="button"
  class="toggle"
  aria-label="Switch to light theme"
  title="Switch to light theme"
>
  <svg class="icon icon--sun" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
  </svg>
  <svg class="icon icon--moon" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
  </svg>
</button>

<style>
  .toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    padding: 0;
    background: none;
    border: 1px solid var(--hairline);
    border-radius: 2px;
    color: var(--muted);
    cursor: pointer;
    transition:
      color var(--dur-quick) var(--ease-out-soft),
      border-color var(--dur-quick) var(--ease-out-soft),
      background-color var(--dur-quick) var(--ease-out-soft);
  }

  .toggle:hover {
    color: var(--accent);
    border-color: var(--accent);
    background: color-mix(in srgb, var(--accent) 12%, transparent);
  }

  .toggle:active { transform: scale(0.92); }

  /* The glyph turns toward the theme you are switching to. */
  .icon { transition: transform var(--dur-base) var(--ease-out-back); }

  .toggle:hover .icon--sun { transform: rotate(72deg); }
  .toggle:hover .icon--moon { transform: rotate(-20deg) scale(1.08); }

  @media (prefers-reduced-motion: reduce) {
    .icon { transition: none; }
    .toggle:active { transform: none; }
  }

  /* Show the icon for the theme you'd switch *to*: sun while dark, moon while
     light. The label is kept in sync by the script below. */
  .icon--sun { display: block; }
  .icon--moon { display: none; }

  :global([data-theme='light']) .icon--sun { display: none; }
  :global([data-theme='light']) .icon--moon { display: block; }
</style>

<script>
  const KEY = 'rw-theme';

  /** The label has to name the action, not the state, or it lies to a screen reader. */
  function label(btn: HTMLElement) {
    const next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
    const text = `Switch to ${next} theme`;
    btn.setAttribute('aria-label', text);
    btn.setAttribute('title', text);
  }

  function wire() {
    const btn = document.getElementById('theme-toggle');
    if (!btn) return;

    label(btn);

    // after-swap replaces the button, so re-wiring is guarded per element.
    if (btn.dataset.wired) return;
    btn.dataset.wired = 'true';

    btn.addEventListener('click', () => {
      const root = document.documentElement;
      const next = root.dataset.theme === 'light' ? 'dark' : 'light';
      root.dataset.theme = next;
      try {
        localStorage.setItem(KEY, next);
      } catch {
        /* private mode — the choice just won't persist */
      }
      label(btn);
    });
  }

  wire();
  document.addEventListener('astro:after-swap', wire);
</script>
