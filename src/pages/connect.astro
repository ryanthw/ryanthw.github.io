---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';

/*
 * The GitHub link was gated on `risk-dashboard-react` being sanitized and made
 * public (PLAN.md §10). That landed in session 1.5, so the profile now shows a
 * real flagship repo and the link is live.
 */
const links = [
  {
    label: 'GitHub',
    handle: 'github.com/ryanthw',
    note: 'Source for the risk dashboard and this site.',
    href: 'https://github.com/ryanthw',
    external: true,
  },
  {
    label: 'LinkedIn',
    handle: '/in/ryan-walker-gt',
    note: 'Full background and work history.',
    href: 'https://www.linkedin.com/in/ryan-walker-gt',
    external: true,
  },
  {
    label: 'Email',
    handle: 'ryan1walker5@gmail.com',
    note: 'Fastest way to reach me.',
    href: 'mailto:ryan1walker5@gmail.com',
    external: false,
  },
  {
    label: 'Résumé',
    handle: 'Ryan_Walker_Resume.pdf',
    note: 'One page, always current.',
    href: '/Ryan_Walker_Resume.pdf',
    external: false,
  },
];

const facts = [
  { label: 'Based in', value: 'Atlanta, Georgia' },
  { label: 'Open to', value: 'Internships · New grad · Remote or relocation' },
];
---

<BaseLayout
  title="Connect"
  description="Get in touch with Ryan Walker — GitHub, LinkedIn, email, and resume."
>
  <div class="wrap">
    <PageHeader
      eyebrow="Connect"
      title="Let's talk"
      size="display"
      lede="Looking for software engineering internships and new-grad roles — particularly where systems work meets quantitative problems."
    />

    <ul class="grid">
      {
        links.map((l) => (
          <li>
            <a
              class="link"
              href={l.href}
              target={l.external ? '_blank' : undefined}
              rel={l.external ? 'noopener noreferrer' : undefined}
              data-animate
            >
              <span class="top">
                <span class="label">{l.label}</span>
                <span class="arrow" aria-hidden="true">
                  ↗
                </span>
              </span>
              <span class="handle">{l.handle}</span>
              <span class="note">{l.note}</span>
            </a>
          </li>
        ))
      }
    </ul>

    <dl class="facts" data-animate>
      {
        facts.map((f) => (
          <div class="fact">
            <dt>{f.label}</dt>
            <dd>{f.value}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</BaseLayout>

<style>
  /* Hairline gaps between cells rather than four bordered boxes. */
  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    background: var(--hairline);
    border: 1px solid var(--hairline);
    border-radius: 3px;
    overflow: hidden;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .link {
    background: var(--surface);
    padding: 26px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-height: 130px;
    height: 100%;
    transition: background-color 120ms var(--ease-out-soft);
  }

  .link:hover { background: var(--canvas); }

  .top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .label {
    font-family: var(--font-mono), ui-monospace, monospace;
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .arrow {
    font-family: var(--font-mono), ui-monospace, monospace;
    font-size: 13px;
    color: var(--faint);
  }

  .handle {
    font-family: var(--font-display), sans-serif;
    font-weight: 700;
    font-size: 19px;
    letter-spacing: -0.012em;
    overflow-wrap: anywhere;
  }

  .note {
    font-size: 13.5px;
    color: var(--muted);
    line-height: 1.5;
  }

  .facts {
    margin: 0;
    padding-top: 36px;
    display: flex;
    gap: 40px;
    flex-wrap: wrap;
  }

  .fact {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .fact dt {
    font-family: var(--font-mono), ui-monospace, monospace;
    font-size: 10.5px;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .fact dd {
    margin: 0;
    font-size: 15px;
    color: var(--prose);
  }

  @media (max-width: 640px) {
    .grid { grid-template-columns: minmax(0, 1fr); }

    .link { padding: 22px; min-height: 0; }
  }
</style>
