---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import TechIcon from '../components/TechIcon.astro';

/** Locked group order from the approved Stack artboard. */
const GROUPS = [
  'Languages',
  'ML & Data',
  'Web',
  'Cloud & Infrastructure',
  'Tools & Observability',
] as const;

const skills = (await getCollection('skills')).sort((a, b) => a.data.order - b.data.order);

/**
 * Each chip points at where the technology was actually used.
 *
 * A skill can have several pieces of evidence. The tile links to the strongest
 * single one — a project detail page ahead of a job, and within projects the
 * lowest `order`, which is the flagship — and the accessible name says how many
 * others there are. Anchor contract: the Experience accordion gives each card
 * `id="job-<entry id>"`.
 */
const tiles = await Promise.all(
  skills.map(async (skill) => {
    const [jobs, projects] = await Promise.all([
      Promise.all(skill.data.usedIn.jobs.map((ref) => getEntry(ref))),
      Promise.all(skill.data.usedIn.projects.map((ref) => getEntry(ref))),
    ]);

    const targets = [
      ...projects
        .filter((p) => p != null)
        .sort((a, b) => a.data.order - b.data.order)
        .map((p) => ({ href: `/projects/${p.id}/`, name: p.data.title })),
      ...jobs
        .filter((j) => j != null)
        .sort((a, b) => b.data.order - a.data.order)
        .map((j) => ({ href: `/experience/#job-${j.id}`, name: j.data.company })),
    ];

    const [primary, ...rest] = targets;

    return {
      skill,
      href: primary?.href,
      label: primary
        ? `${skill.data.label} — used in ${primary.name}${
            rest.length ? ` and ${rest.length} other${rest.length === 1 ? '' : 's'}` : ''
          }`
        : undefined,
    };
  }),
);

const counts = new Map(GROUPS.map((g) => [g, skills.filter((s) => s.data.group === g).length]));
const total = skills.length;
const linked = tiles.filter((t) => t.href).length;
---

<BaseLayout
  title="Stack"
  description="Languages, ML and data, web, cloud and infrastructure, and tooling Ryan Walker works in."
>
  <div class="wrap">
    <PageHeader
      eyebrow="Stack"
      title="Technologies"
      lede={`${total} technologies I have shipped something with — grouped by what they are for, not by how well I claim to know them.`}
    >
      <p class="legend">
        <span class="dot"></span>{linked} link to where they were used
      </p>
    </PageHeader>

    {
      GROUPS.map((group) => (
        <section class="group" aria-labelledby={`grp-${group.replace(/\W+/g, '-').toLowerCase()}`}>
          <div class="group-head">
            <h2 id={`grp-${group.replace(/\W+/g, '-').toLowerCase()}`}>{group}</h2>
            <span class="count">
              {String(counts.get(group)).padStart(2, '0')} technologies
            </span>
          </div>

          <ul class="grid">
            {tiles
              .filter((t) => t.skill.data.group === group)
              .map(({ skill, href, label }, i) => {
                const Tag = href ? 'a' : 'div';
                /* Stagger by column, not by position in the group: the grid is
                   five wide at desktop, so `i % 5` makes each row cascade
                   left-to-right instead of the offset growing without bound
                   down a twelve-item group. */
                return (
                  <li data-animate style={`--i:${i % 5}`}>
                    <Tag
                      class:list={['tile', href && 'tile--linked']}
                      href={href}
                      aria-label={label}
                    >
                      <span class="mark">
                        <TechIcon label={skill.data.label} />
                      </span>
                      <span class="name">
                        <span class="label">{skill.data.label}</span>
                        {skill.data.note && <span class="note">{skill.data.note}</span>}
                      </span>
                    </Tag>
                  </li>
                );
              })}
          </ul>
        </section>
      ))
    }
  </div>
</BaseLayout>

<style>
  .legend {
    margin: 2px 0 0;
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono), ui-monospace, monospace;
    font-size: 10.5px;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--faint);
  }

  .legend .dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--accent);
    flex: none;
  }

  .group {
    display: grid;
    grid-template-columns: 180px minmax(0, 1fr);
    gap: 32px;
    padding: 30px 0;
    align-items: start;
    border-top: 1px solid var(--hairline);
  }

  .group:first-of-type { border-top: 0; }

  /* Clears the sticky nav (68px) plus the original 24px of breathing room. */
  .group-head {
    display: flex;
    flex-direction: column;
    gap: 6px;
    position: sticky;
    top: 92px;
  }

  .group-head h2 {
    font-weight: 700;
    font-size: 19px;
    letter-spacing: -0.014em;
    line-height: 1.15;
  }

  .count {
    font-family: var(--font-mono), ui-monospace, monospace;
    font-size: 10.5px;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: var(--faint);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 10px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .tile {
    position: relative;
    height: 100%;
    background: var(--surface);
    border: 1px solid var(--hairline);
    border-radius: 3px;
    padding: 14px 12px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 9px;
    text-align: center;
    min-height: 92px;
    transition:
      border-color var(--dur-quick) var(--ease-out-soft),
      transform var(--dur-base) var(--ease-out-back),
      box-shadow var(--dur-base) var(--ease-out-soft);
  }

  /* A linked tile carries the accent dot the legend explains. */
  .tile--linked::after {
    content: '';
    position: absolute;
    top: 8px;
    right: 8px;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--accent);
    transition: transform var(--dur-base) var(--ease-out-back);
  }

  /* Only a linked tile lifts. The others are <div>s with nothing behind them,
     so moving them would promise a click that does not exist — they get the
     mark scale and nothing more. */
  .tile--linked:hover,
  .tile--linked:focus-visible {
    border-color: var(--accent);
    transform: translateY(-4px);
    box-shadow: var(--lift);
  }

  .tile--linked:hover .label,
  .tile--linked:focus-visible .label { color: var(--accent); }

  .tile--linked:hover::after { transform: scale(1.8); }

  .mark {
    height: 26px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform var(--dur-base) var(--ease-out-back);
  }

  .tile:hover .mark { transform: scale(1.16); }

  @media (prefers-reduced-motion: reduce) {
    .tile,
    .mark,
    .tile--linked::after { transition-duration: 1ms; }

    .tile--linked:hover,
    .tile--linked:focus-visible { transform: none; }

    .tile:hover .mark { transform: none; }
  }

  .name {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .label {
    font-size: 12.5px;
    color: var(--text);
    line-height: 1.25;
    transition: color var(--dur-quick) var(--ease-out-soft);
  }

  .note {
    font-family: var(--font-mono), ui-monospace, monospace;
    font-size: 9px;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--faint);
  }

  @media (max-width: 980px) {
    .group {
      grid-template-columns: minmax(0, 1fr);
      gap: 18px;
    }

    .group-head {
      position: static;
      flex-direction: row;
      align-items: baseline;
      justify-content: space-between;
    }

    .grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }

  @media (max-width: 640px) {
    .grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
</style>
