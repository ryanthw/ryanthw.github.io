---
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TechIcon from '../../components/TechIcon.astro';

export const getStaticPaths = (async () => {
  const projects = await getCollection('projects');
  return projects
    .filter((p) => !p.data.draft)
    .map((project) => ({ params: { slug: project.id }, props: { project } }));
}) satisfies GetStaticPaths;

const { project } = Astro.props;
const { data } = project;
const { Content } = await render(project);

const LABEL: Record<string, string> = { quant: 'Quant', ml: 'ML', web: 'Web' };

/* Read in order: the problem, what was built, what it changed. */
const sections = [
  { heading: 'The problem', body: data.problem },
  { heading: 'What I built', body: data.approach },
  { heading: 'What it changed', body: data.result },
];
---

<BaseLayout title={data.title} description={data.tagline}>
  <div class="wrap">
    <p class="back" data-reveal style="--i:0">
      <a href="/projects/"><i class="arrow">←</i> All projects</a>
    </p>

    <header class="head">
      <p class="meta" data-reveal style="--i:1">
        <span class="cat">{data.categories.map((c) => LABEL[c]).join(' · ')}</span>
        <span class="sep" aria-hidden="true">·</span>
        <span class="year">{data.year}</span>
      </p>

      <h1 data-reveal style="--i:2">{data.title}</h1>
      <p class="tagline" data-reveal style="--i:3">{data.tagline}</p>

      {
        (data.live || data.repo) && (
          <div class="cta" data-reveal style="--i:4">
            {data.live && (
              <a
                class="btn btn--solid"
                href={data.live}
                target="_blank"
                rel="noopener noreferrer"
              >
                Live demo ↗
              </a>
            )}
            {data.repo && (
              <a class="btn" href={data.repo} target="_blank" rel="noopener noreferrer">
                GitHub ↗
              </a>
            )}
          </div>
        )
      }
    </header>

    {
      data.cover && (
        <figure class="cover" data-animate>
          <Image src={data.cover} alt={`${data.title} — screenshot`} widths={[720, 1120]} />
        </figure>
      )
    }

    {
      data.highlights.length > 0 && (
        <section class="measures" data-animate>
          <h2 class="eyebrow">What it measures</h2>
          <ul class="measure-grid">
            {data.highlights.map((h) => (
              <li class="measure">
                <span class="k">{h.label}</span>
                <span class="d">{h.detail}</span>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <div class="build">
      <div class="prose-col">
        {
          sections.map((s, i) => (
            <section class="section" data-animate style={`--i:${i}`}>
              <h2 class="eyebrow">{s.heading}</h2>
              <p>{s.body}</p>
            </section>
          ))
        }

        <div class="prose" data-animate>
          <Content />
        </div>
      </div>

      <aside class="side">
        {
          data.stack.length > 0 && (
            <section class="side-block" data-animate>
              <h2 class="eyebrow">Stack</h2>
              <ul class="tech">
                {data.stack.map((t) => (
                  <li>
                    <TechIcon label={t} size={16} />
                    <span>{t}</span>
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        {
          data.media.length > 0 && (
            <section class="side-block" data-animate>
              <h2 class="eyebrow">Evidence</h2>
              <div class="shots">
                {data.media.map((m) => (
                  <figure>
                    <Image src={m.src} alt={m.alt} widths={[300, 600]} />
                    {m.caption && <figcaption>{m.caption}</figcaption>}
                  </figure>
                ))}
              </div>
            </section>
          )
        }
      </aside>
    </div>
  </div>
</BaseLayout>

<style>
  .back {
    margin: 0;
    padding-top: 44px;
    font-family: var(--font-mono), ui-monospace, monospace;
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .back .arrow {
    display: inline-block;
    font-style: normal;
    transition: transform var(--dur-base) var(--ease-out-back);
  }

  .back a:hover .arrow { transform: translateX(-4px); }

  .head {
    padding: 26px 0 34px;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .meta {
    margin: 0;
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-mono), ui-monospace, monospace;
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .cat { color: var(--accent); }
  .year { color: var(--muted); }
  .sep { color: var(--hairline); }

  h1 {
    font-weight: 800;
    font-size: clamp(38px, 6.4vw, 58px);
    line-height: 1;
    letter-spacing: -0.032em;
    text-transform: uppercase;
  }

  .tagline {
    margin: 0;
    max-width: 62ch;
    font-size: 17px;
    line-height: 1.62;
    color: var(--prose);
  }

  .cta {
    display: flex;
    gap: 12px;
    padding-top: 4px;
    flex-wrap: wrap;
  }

  /* Same gold wipe as the home hero — see index.astro for the reasoning. */
  .btn {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    font-family: var(--font-mono), ui-monospace, monospace;
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border: 1px solid var(--hairline);
    color: var(--text);
    padding: 10px 18px;
    border-radius: 2px;
    transition:
      color var(--dur-quick) var(--ease-out-soft),
      border-color var(--dur-quick) var(--ease-out-soft),
      transform var(--dur-base) var(--ease-out-back);
  }

  .btn::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: 0 50%;
    transition: transform var(--dur-base) var(--ease-out-back);
  }

  .btn:hover,
  .btn:focus-visible {
    border-color: var(--accent);
    color: var(--on-accent);
    transform: translateY(-2px);
  }

  .btn:hover::before,
  .btn:focus-visible::before { transform: scaleX(1); }

  .btn:active { transform: translateY(0); }

  .btn--solid {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--on-accent);
    font-weight: 600;
  }

  .btn--solid::before { background: color-mix(in srgb, var(--accent) 80%, #fff); }

  .btn--solid:hover,
  .btn--solid:focus-visible {
    color: var(--on-accent);
    box-shadow: var(--lift);
  }

  @media (prefers-reduced-motion: reduce) {
    .btn,
    .btn::before { transition-duration: 1ms; }

    .btn:hover,
    .btn:focus-visible { transform: none; }
  }

  .cover {
    margin: 0;
    border: 1px solid var(--hairline);
    border-radius: 3px;
    overflow: hidden;
    transition: border-color var(--dur-base) var(--ease-out-soft);
  }

  .cover:hover { border-color: var(--monogram-border); }

  .cover :global(img) {
    width: 100%;
    height: auto;
    display: block;
    transition: transform var(--dur-slow) var(--ease-out-soft);
  }

  @media (prefers-reduced-motion: no-preference) {
    .cover:hover :global(img) { transform: scale(1.02); }
  }

  .measures {
    padding-top: 44px;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  /* Hairline gaps rather than borders, matching the Connect grid. */
  .measure-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1px;
    background: var(--hairline);
    border: 1px solid var(--hairline);
    border-radius: 3px;
    overflow: hidden;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .measure-grid li {
    background: var(--surface);
    padding: 18px 16px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-height: 104px;
    transition: background-color var(--dur-base) var(--ease-out-soft);
  }

  /* Clipped hairline seams again, so the feedback stays inside the cell. */
  .measure-grid li:hover { background: var(--canvas); }

  .k {
    font-family: var(--font-mono), ui-monospace, monospace;
    font-size: 10.5px;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .d {
    font-size: 13px;
    color: var(--muted);
    line-height: 1.5;
  }

  .build {
    padding-top: 46px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: 48px;
    align-items: start;
  }

  .prose-col {
    display: flex;
    flex-direction: column;
    gap: 26px;
  }

  .section {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .section p {
    margin: 0;
    font-size: 15px;
    color: var(--prose);
    line-height: 1.68;
  }

  .prose { color: var(--prose); }

  .prose :global(h2) {
    font-family: var(--font-mono), ui-monospace, monospace;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0 0 10px;
  }

  .prose :global(h2:not(:first-child)) { margin-top: 26px; }

  .prose :global(p) {
    margin: 0 0 12px;
    font-size: 15px;
    line-height: 1.68;
  }

  .prose :global(ul) {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 7px;
  }

  /* Marker is positioned, not a grid column: a markdown <li> holds inline
     children, and grid would lay each of them out as its own item. */
  .prose :global(li) {
    position: relative;
    padding-left: 22px;
    font-size: 14.5px;
    line-height: 1.6;
  }

  .prose :global(li)::before {
    content: '▸';
    position: absolute;
    left: 0;
    top: 0;
    color: var(--accent);
    font-family: var(--font-mono), ui-monospace, monospace;
    font-size: 11px;
    line-height: 1.9;
  }

  .prose :global(strong) {
    color: var(--text);
    font-weight: 600;
  }

  .side {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .side-block {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .tech {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 9px;
  }

  .tech li {
    display: flex;
    align-items: center;
    gap: 9px;
    font-size: 13.5px;
    color: var(--prose);
    transition:
      color var(--dur-quick) var(--ease-out-soft),
      transform var(--dur-base) var(--ease-out-back);
  }

  .tech li:hover {
    color: var(--text);
    transform: translateX(4px);
  }

  .tech li :global(.tech-icon) {
    transition: transform var(--dur-base) var(--ease-out-back);
  }

  .tech li:hover :global(.tech-icon) { transform: scale(1.2); }

  @media (prefers-reduced-motion: reduce) {
    .tech li:hover,
    .tech li:hover :global(.tech-icon) { transform: none; }
  }

  .shots {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .shots figure {
    margin: 0;
    border: 1px solid var(--hairline);
    border-radius: 3px;
    overflow: hidden;
    transition: border-color var(--dur-base) var(--ease-out-soft);
  }

  .shots figure:hover { border-color: var(--accent); }

  .shots :global(img) {
    width: 100%;
    height: auto;
    display: block;
  }

  .shots figcaption {
    padding: 8px 10px;
    font-family: var(--font-mono), ui-monospace, monospace;
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--faint);
    border-top: 1px solid var(--hairline);
  }

  @media (max-width: 980px) {
    .measure-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }

    .build {
      grid-template-columns: minmax(0, 1fr);
      gap: 34px;
    }
  }

  @media (max-width: 640px) {
    .measure-grid { grid-template-columns: minmax(0, 1fr); }

    .measure-grid li { min-height: 0; }
  }
</style>
