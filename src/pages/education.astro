---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';

const courses = await getCollection('courses');

/** Newest term first, matching the approved Education artboard. */
const terms = [...new Set(courses.map((c) => c.data.termOrder))]
  .sort((a, b) => b - a)
  .map((termOrder) => {
    /* Collections come back id-sorted, so re-impose editorial order: the
       courses this audience reads for lead the row, then by code. */
    const inTerm = courses
      .filter((c) => c.data.termOrder === termOrder)
      .sort(
        (a, b) =>
          Number(b.data.highlight) - Number(a.data.highlight) ||
          a.data.code.localeCompare(b.data.code),
      );
    const first = inTerm[0].data;
    return {
      name: first.term,
      campus: first.campus,
      inProgress: first.inProgress,
      courses: inTerm,
    };
  });

const facts = [
  { label: 'Concentration', value: 'Information & Internetworks / Intelligence' },
  { label: 'Minor', value: 'Fintech' },
  { label: 'Study abroad', value: 'Georgia Tech Europe — Metz, France · Summer 2025' },
  { label: 'Standing', value: 'Faculty Honors, every eligible term' },
];
---

<BaseLayout
  title="Education"
  description="BS Computer Science at Georgia Tech — Info/Internetwork-Intelligence concentration, Fintech minor, 4.00 GPA."
>
  <div class="wrap">
    <PageHeader eyebrow="Education" title="Georgia Tech" />

    <section class="degree" data-animate>
      <div class="detail">
        <div class="title">
          <h2>BS Computer Science</h2>
          <p class="sub">College of Computing &nbsp;·&nbsp; Expected May 2028</p>
        </div>

        <dl class="facts">
          {
            facts.map((f) => (
              <div class="fact">
                <dt>{f.label}</dt>
                <dd>{f.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>

      <div class="rail">
        <div class="cell">
          <span class="figure figure--accent">4.00</span>
          <span class="cell-label">Cumulative GPA</span>
        </div>
        <div class="cell">
          <span class="figure">94</span>
          <span class="cell-label">Credit hours earned</span>
        </div>
        <div class="cell cell--link">
          <a href="/Ryan_Walker_Resume.pdf" download>Résumé ↓</a>
        </div>
      </div>
    </section>

    <section class="coursework">
      <div class="course-head" data-animate>
        <h2 class="eyebrow">Coursework by term</h2>
        <span class="aside">All A unless noted</span>
      </div>

      <ol class="terms">
        {
          terms.map((term) => (
            <li class="term" data-animate>
              <div class="term-label">
                <span class:list={['term-name', term.inProgress && 'term-name--live']}>
                  {term.name}
                </span>
                <span class="term-note">
                  {term.inProgress ? 'In progress' : (term.campus ?? `${term.courses.length} courses`)}
                </span>
              </div>

              <ul class="courses">
                {term.courses.map((c) => (
                  <li class:list={['course', c.data.highlight && 'course--key']}>
                    <span class="code">{c.data.code}</span>
                    <span class="course-title">{c.data.title}</span>
                    {c.data.grade !== 'A' && !c.data.inProgress && (
                      <span class="grade">{c.data.grade}</span>
                    )}
                  </li>
                ))}
              </ul>
            </li>
          ))
        }
      </ol>

      <p class="transfer" data-animate>
        Plus 26 hours of AP transfer credit — chemistry, physics, calculus, composition
        and history.
      </p>
    </section>
  </div>
</BaseLayout>

<style>
  .degree {
    border: 1px solid var(--hairline);
    border-radius: 3px;
    background: var(--surface);
    padding: 28px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: 40px;
  }

  .detail {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .title {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .title h2 {
    font-weight: 700;
    font-size: 24px;
    letter-spacing: -0.018em;
  }

  .sub {
    margin: 0;
    font-family: var(--font-mono), ui-monospace, monospace;
    font-size: 12.5px;
    color: var(--muted);
  }

  .facts {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 9px;
  }

  .fact {
    display: grid;
    grid-template-columns: 150px minmax(0, 1fr);
    gap: 14px;
  }

  .fact dt {
    font-family: var(--font-mono), ui-monospace, monospace;
    font-size: 11px;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .fact dd {
    margin: 0;
    font-size: 14.5px;
    color: var(--prose);
  }

  /* Hairline gaps rather than borders — the cells sit on the divider colour. */
  .rail {
    display: flex;
    flex-direction: column;
    gap: 1px;
    background: var(--hairline);
    border: 1px solid var(--hairline);
    border-radius: 3px;
    overflow: hidden;
    align-self: start;
  }

  .cell {
    background: var(--canvas);
    padding: 16px 18px;
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .cell--link { padding: 14px 18px; }

  .cell--link a {
    font-family: var(--font-mono), ui-monospace, monospace;
    font-size: 11px;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .figure {
    font-family: var(--font-display), sans-serif;
    font-weight: 700;
    font-size: 30px;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  .figure--accent { color: var(--accent); }

  .cell-label {
    font-family: var(--font-mono), ui-monospace, monospace;
    font-size: 10.5px;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .coursework {
    padding-top: 46px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .course-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
  }

  .aside {
    font-family: var(--font-mono), ui-monospace, monospace;
    font-size: 10.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--faint);
  }

  .terms {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--hairline);
  }

  .term {
    display: grid;
    grid-template-columns: 190px minmax(0, 1fr);
    gap: 28px;
    padding: 20px 0;
    border-bottom: 1px solid var(--hairline);
    align-items: start;
  }

  .term-label {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .term-name {
    font-family: var(--font-mono), ui-monospace, monospace;
    font-size: 12.5px;
    font-weight: 500;
    letter-spacing: 0.03em;
    color: var(--text);
  }

  .term-name--live { color: var(--accent); }

  .term-note {
    font-family: var(--font-mono), ui-monospace, monospace;
    font-size: 10.5px;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--faint);
  }

  .courses {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .course {
    display: flex;
    align-items: baseline;
    gap: 7px;
    font-family: var(--font-mono), ui-monospace, monospace;
    font-size: 11.5px;
    color: var(--prose);
    background: var(--surface);
    border: 1px solid var(--hairline);
    border-radius: 2px;
    padding: 5px 10px;
  }

  /* The courses this audience reads for. Everything else stays quiet. */
  .course--key { border-color: var(--monogram-border); }

  .code { color: var(--accent); }

  .course-title { color: var(--prose); }

  .grade {
    color: var(--faint);
    font-size: 10px;
    letter-spacing: 0.08em;
  }

  .transfer {
    margin: 0;
    padding-top: 6px;
    font-size: 13.5px;
    color: var(--muted);
  }

  @media (max-width: 860px) {
    .degree {
      grid-template-columns: minmax(0, 1fr);
      gap: 26px;
      padding: 22px;
    }

    .fact { grid-template-columns: minmax(0, 1fr); gap: 2px; }

    .term { grid-template-columns: minmax(0, 1fr); gap: 12px; }

    .coursework { padding-top: 36px; }
  }
</style>
