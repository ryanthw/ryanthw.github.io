---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import headshot from '../assets/headshot.jpg';
import { getCollection, getEntry } from 'astro:content';

/*
 * Selected work — the three cards from the approved Main artboard: the two
 * featured projects either side of the Sonatype role. Cards one and three come
 * from the projects collection, so editing a project entry updates the home
 * page too.
 */
const featuredProjects = (await getCollection('projects'))
  .filter((p) => p.data.featured && !p.data.draft)
  .sort((a, b) => a.data.order - b.data.order)
  .map((p) => ({
    tag: p.data.live || p.data.repo ? 'Live' : p.data.year,
    title: p.data.title,
    blurb: p.data.tagline,
    stack: p.data.stack.slice(0, 3),
    href: `/projects/${p.id}/`,
  }));

const sonatype = await getEntry('jobs', 'sonatype');

const featured = [
  featuredProjects[0],
  sonatype && {
    tag: 'Summer 2026',
    title: `${sonatype.data.company} — SWE Intern`,
    blurb: sonatype.data.summary,
    stack: sonatype.data.stack.slice(0, 3),
    href: `/experience/#job-${sonatype.id}`,
  },
  featuredProjects[1],
].filter((c) => c != null);

const stats = [
  { value: 'Georgia Tech', label: 'BS Computer Science · 2028' },
  { value: '4.00', label: 'Cumulative GPA', accent: true },
  { value: 'Fintech', label: 'Minor · Info/Intelligence' },
  { value: 'Atlanta', label: 'Georgia, USA' },
];
---

<BaseLayout
  title="Ryan Walker"
  description="Third-year CS at Georgia Tech — cloud infrastructure and tooling at Sonatype, and a production options-risk platform."
>
  <div class="wrap">
    {/* The hero fades in with everything else — Ryan's call, 2026-08-31. It
        costs roughly 390ms of LCP render delay because the observer gates the
        paint; the Lighthouse budget absorbs it. Removing data-animate from
        these five elements is the revert. */}
    <section class="hero">
      <div class="intro">
        <p class="eyebrow lead" data-animate>
          <span class="dot"></span>Software Engineer &nbsp;·&nbsp; Atlanta, GA
        </p>
        <h1 data-animate>Ryan<br />Walker</h1>
        <p class="lede" data-animate>
          Third-year CS at Georgia Tech, drawn to work where I own the whole system —
          cloud infrastructure and tooling at Sonatype, and a production options-risk
          platform of my own.
        </p>
        <div class="cta" data-animate>
          <a class="btn btn--solid" href="/projects/">View Projects</a>
          <a class="btn" href="/Ryan_Walker_Resume.pdf" download>Résumé ↓</a>
        </div>
      </div>

      <div class="portrait" data-animate>
        <Image
          src={headshot}
          alt="Ryan Walker"
          widths={[260, 400, 520]}
          sizes="(max-width: 860px) 200px, 260px"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </section>

    <section class="stats" aria-label="At a glance">
      {
        stats.map((s) => (
          <div class="stat" data-animate>
            <span class:list={['stat-value', s.accent && 'stat-value--accent']}>{s.value}</span>
            <span class="stat-label">{s.label}</span>
          </div>
        ))
      }
    </section>

    <section class="work">
      <div class="work-head" data-animate>
        <h2 class="eyebrow">Selected Work</h2>
        <a class="all" href="/projects/">All projects →</a>
      </div>

      <ul class="cards">
        {
          featured.map((f, i) => (
            <li data-animate>
              <a class="card" href={f.href}>
                <div class="card-top">
                  <span class="index">_{String(i + 1).padStart(2, '0')}</span>
                  <span class="tag">{f.tag}</span>
                </div>
                <h3>{f.title}</h3>
                <p>{f.blurb}</p>
                <div class="chips">
                  {f.stack.map((t) => (
                    <span class="chip">{t}</span>
                  ))}
                </div>
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</BaseLayout>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 260px;
    gap: 56px;
    align-items: end;
    padding: 88px 0 44px;
  }

  .intro {
    display: flex;
    flex-direction: column;
    gap: 26px;
  }

  .lead {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0;
  }

  .dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--accent);
    flex: none;
  }

  h1 {
    font-weight: 800;
    font-size: clamp(52px, 9vw, 92px);
    line-height: 0.92;
    letter-spacing: -0.035em;
    text-transform: uppercase;
  }

  .lede {
    margin: 0;
    max-width: 52ch;
    font-size: 18px;
    line-height: 1.62;
    color: var(--prose);
  }

  .cta {
    display: flex;
    gap: 12px;
    padding-top: 6px;
    flex-wrap: wrap;
  }

  .btn {
    font-family: var(--font-mono), ui-monospace, monospace;
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border: 1px solid var(--hairline);
    color: var(--text);
    padding: 11px 20px;
    border-radius: 2px;
    transition:
      color 120ms var(--ease-out-soft),
      border-color 120ms var(--ease-out-soft),
      background-color 120ms var(--ease-out-soft);
  }

  .btn:hover { border-color: var(--accent); color: var(--accent); }

  .btn--solid {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--on-accent);
    font-weight: 600;
  }

  .btn--solid:hover {
    color: var(--on-accent);
    opacity: 0.88;
  }

  .portrait {
    width: 260px;
    height: 300px;
    border: 1px solid var(--hairline);
    border-radius: 3px;
    overflow: hidden;
    background: var(--surface);
  }

  .portrait :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 32%;
    display: block;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid var(--hairline);
    border-bottom: 1px solid var(--hairline);
  }

  .stat {
    padding: 22px 0 22px 28px;
    border-left: 1px solid var(--hairline);
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .stat:first-child {
    padding-left: 0;
    border-left: 0;
  }

  .stat-value {
    font-family: var(--font-display), sans-serif;
    font-weight: 700;
    font-size: 26px;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }

  .stat-value--accent { color: var(--accent); }

  .stat-label {
    font-family: var(--font-mono), ui-monospace, monospace;
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .work {
    padding-top: 64px;
    display: flex;
    flex-direction: column;
    gap: 26px;
  }

  .work-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
  }

  .all {
    font-family: var(--font-mono), ui-monospace, monospace;
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .card {
    height: 100%;
    transition: border-color 120ms var(--ease-out-soft);
    background: var(--surface);
    border: 1px solid var(--hairline);
    border-radius: 3px;
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-height: 250px;
  }

  .card:hover { border-color: var(--accent); }
  .card:hover h3 { color: var(--accent); }

  .card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .index {
    font-family: var(--font-mono), ui-monospace, monospace;
    font-size: 11px;
    letter-spacing: 0.1em;
    color: var(--accent);
  }

  .tag {
    font-family: var(--font-mono), ui-monospace, monospace;
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--faint);
  }

  .card h3 {
    transition: color 120ms var(--ease-out-soft);
    font-weight: 700;
    font-size: 22px;
    letter-spacing: -0.015em;
    line-height: 1.15;
  }

  .card p {
    margin: 0;
    font-size: 14px;
    color: var(--muted);
    line-height: 1.55;
    flex-grow: 1;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .chip {
    font-family: var(--font-mono), ui-monospace, monospace;
    font-size: 10px;
    letter-spacing: 0.06em;
    color: var(--muted);
    border: 1px solid var(--hairline);
    border-radius: 2px;
    padding: 3px 8px;
  }

  @media (max-width: 980px) {
    .cards { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 860px) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
      gap: 32px;
      padding: 48px 0 36px;
      align-items: start;
    }

    .portrait { width: 200px; height: 232px; }

    .stats { grid-template-columns: repeat(2, minmax(0, 1fr)); }

    .stat { padding: 18px 0 18px 20px; }

    .stat:nth-child(3) {
      padding-left: 0;
      border-left: 0;
    }

    .stat:nth-child(n + 3) { border-top: 1px solid var(--hairline); }

    .work { padding-top: 44px; }

    .cards { grid-template-columns: minmax(0, 1fr); }

    .card { min-height: 0; }
  }
</style>
