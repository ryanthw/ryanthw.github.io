---
import { Font } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Overrides the site-wide card. Path is resolved against `site`. */
  ogImage?: string;
}

const { title, description, ogImage } = Astro.props;

const SITE_NAME = 'Ryan Walker';
const fullTitle = title === SITE_NAME ? title : `${title} · ${SITE_NAME}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
/* Regenerate with `npm run og` — see scripts/build-og.mjs. */
const og = new URL(ogImage ?? '/og.png', Astro.site).href;
---

<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!--
      theme-color has no CSS-variable form, so these two are the only raw hex
      outside src/styles/global.css. They mirror --canvas in each theme; if the
      palette moves, move them too.
    -->
    <meta name="theme-color" content="#0B1328" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#F9FAFC" media="(prefers-color-scheme: light)" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="canonical" href={canonical.href} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE_NAME} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${SITE_NAME} — ${description}`} />
    <meta name="twitter:card" content="summary_large_image" />

    <!--
      Theme resolution must run before first paint, or a light-mode visitor
      gets a dark flash on every navigation. Inline and synchronous on purpose.
    -->
    <script is:inline>
      (function () {
        var KEY = 'rw-theme';

        function apply() {
          var theme;
          try {
            theme = localStorage.getItem(KEY);
          } catch (e) {
            /* private mode */
          }
          if (theme !== 'light' && theme !== 'dark') {
            theme = window.matchMedia('(prefers-color-scheme: light)').matches
              ? 'light'
              : 'dark';
          }
          document.documentElement.dataset.theme = theme;
        }

        apply();

        if (!window.__rwThemeBound) {
          window.__rwThemeBound = true;

          // Astro's view-transition swap calls swapRootAttributes(), which strips
          // every attribute off <html> and re-applies the incoming document's.
          // Every page ships the static data-theme="dark", so without this the
          // chosen theme is wiped on each client-side navigation. after-swap
          // fires before paint, so re-applying here costs no flash.
          document.addEventListener('astro:after-swap', apply);

          // Follow the OS only while the visitor has made no explicit choice.
          window
            .matchMedia('(prefers-color-scheme: light)')
            .addEventListener('change', function () {
              var stored = null;
              try {
                stored = localStorage.getItem(KEY);
              } catch (e) {
                /* private mode */
              }
              if (stored !== 'light' && stored !== 'dark') apply();
            });
        }
      })();
    </script>

    <Font cssVariable="--font-display" preload />
    <Font cssVariable="--font-body" preload />
    <Font cssVariable="--font-mono" />

    <ClientRouter />
  </head>

  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <style is:global>
      /* Locked motion budget: 120ms page cross-fade, nothing more. */
      @view-transition {
        navigation: auto;
      }

      ::view-transition-old(root),
      ::view-transition-new(root) {
        animation-duration: 120ms;
      }

      @media (prefers-reduced-motion: reduce) {
        ::view-transition-old(root),
        ::view-transition-new(root) {
          animation: none;
        }
      }

      .skip {
        position: absolute;
        left: -9999px;
        top: 0;
        z-index: 100;
        background: var(--accent);
        color: var(--on-accent);
        font-family: var(--font-mono), ui-monospace, monospace;
        font-size: 12px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        padding: 10px 18px;
      }

      .skip:focus {
        left: 0;
        color: var(--on-accent);
      }
    </style>
  </body>
</html>
